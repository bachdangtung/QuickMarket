@model List<BussinessLogic.DTOs.Messages.ChatHistoryDto>

@{
    ViewData["Title"] = "All Chats";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5>Your Conversations</h5>
                </div>
                <div class="list-group list-group-flush">
                    @if (Model.Any())
                    {
                        @foreach (var chat in Model)
                        {
                            var lastMessage = chat.Messages.OrderByDescending(m => m.SentTime).FirstOrDefault();
                            var userIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
                            var hasUnreadMessages = lastMessage != null && lastMessage.FromUserId == chat.OtherUserId && 
                                                   userIdClaim != null;
                            
                            <a href="@Url.Action("Index", "Message", new { userId = chat.OtherUserId })" 
                               class="list-group-item list-group-item-action @(hasUnreadMessages ? "fw-bold" : "")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">Chat with: <span class="text-primary">@chat.OtherUsername</span></h6>
                                    </div>
                                    @if (lastMessage != null)
                                    {
                                        <small class="text-muted">@lastMessage.SentTime.ToString("dd/MM HH:mm")</small>
                                    }
                                </div>
                                @if (lastMessage != null)
                                {
                                    <p class="mb-1 text-truncate">
                                        @{
                                            var isFromCurrentUser = userIdClaim != null && lastMessage.FromUserId == int.Parse(userIdClaim.Value);
                                        }
                                        @if (isFromCurrentUser)
                                        {
                                            <span class="text-muted">Bạn: </span>
                                        }
                                        else
                                        {
                                            <span class="text-primary">@chat.OtherUsername: </span>
                                        }
                                        @lastMessage.MessageText
                                    </p>
                                }
                                else
                                {
                                    <p class="mb-1 text-muted">No messages yet</p>
                                }
                            </a>
                        }
                    }
                    else
                    {
                        <div class="list-group-item">
                            <p class="mb-1 text-center text-muted">You don't have any conversations yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100 d-flex align-items-center justify-content-center">
                <div class="text-center p-5">
                    <i class="bi bi-chat-dots" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Select a conversation</h5>
                    <p class="text-muted">Choose a conversation from the list to start chatting.</p>
                </div>
            </div>
        </div>
    </div>
</div>
