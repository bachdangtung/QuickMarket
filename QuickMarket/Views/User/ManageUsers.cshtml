@model BussinessLogic.DTOs.Users.UserManagementDto

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "_Layout";
}

<div class="container mt-4">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
    </div>

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="ManageUsers" method="get" class="row g-3">
                <div class="col-md-10">
                    <div class="input-group">
                        <input type="text" name="searchQuery" class="form-control" placeholder="Tìm kiếm theo tên đăng nhập hoặc email..." value="@Model.SearchQuery">
                        <button class="btn btn-outline-secondary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Lọc</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Users.Any())
    {
        <div class="alert alert-info">
            <p>Không tìm thấy người dùng nào phù hợp với tiêu chí tìm kiếm.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Tên đăng nhập</th>
                        <th>Email</th>
                        <th>Vai trò</th>
                        <th>Ngày đăng ký</th>
                        <th>Lần đăng nhập cuối</th>
                        <th>Số sản phẩm</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr class="@(user.Status == "Deleted" ? "table-secondary" : "")">
                            <td>@user.UserId</td>
                            <td>@user.Username</td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.RoleName == "Admin")
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else if (user.RoleName == "Manager")
                                {
                                    <span class="badge bg-warning">Manager</span>
                                }
                                else if (user.RoleName == "Seller")
                                {
                                    <span class="badge bg-info">Seller</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">User</span>
                                }
                            </td>
                            <td>
                                <div>@user.DateCreated.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted">@user.DateCreated.ToString("HH:mm")</div>
                            </td>
                            <td>
                                @if (user.LastLogin.HasValue)
                                {
                                    <div>@user.LastLogin.Value.ToString("dd/MM/yyyy")</div>
                                    <div class="small text-muted">@user.LastLogin.Value.ToString("HH:mm")</div>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa đăng nhập</span>
                                }
                            </td>
                            <td>@user.ProductCount</td>
                            <td>
                                @if (user.Status == "Active")
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else if (user.Status == "Inactive")
                                {
                                    <span class="badge bg-warning">Vô hiệu hóa</span>
                                }
                                else if (user.Status == "Suspended")
                                {
                                    <span class="badge bg-danger">Tạm khóa</span>
                                }
                                else if (user.Status == "Deleted")
                                {
                                    <span class="badge bg-dark">Đã xóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">@user.Status</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@user.UserId" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (user.Status != "Deleted")
                                    {
                                        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.UserId" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-success" title="Restaurer l'utilisateur">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="ManageUsers" 
                           asp-route-searchQuery="@Model.SearchQuery" 
                           asp-route-page="@(Model.CurrentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                            startPage = Math.Max(1, endPage - 4);
                        }
                    }
                    
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="ManageUsers" 
                               asp-route-searchQuery="@Model.SearchQuery" 
                               asp-route-page="@i">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="ManageUsers" 
                           asp-route-searchQuery="@Model.SearchQuery" 
                           asp-route-page="@(Model.CurrentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<!-- Modal for User Details -->
<div class="modal fade" id="userDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="userDetailsContent">
                <p class="text-center">Đang tải...</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Pas de scripts nécessaires car nous n'utilisons plus d'actions JavaScript pour les changements de statut -->
}
