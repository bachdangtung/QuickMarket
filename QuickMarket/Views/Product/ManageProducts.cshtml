@model BussinessLogic.DTOs.Products.ProductListDto

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <div>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus"></i> Thêm sản phẩm mới
            </a>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="ManageProducts" method="get" class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="text" name="searchQuery" class="form-control" placeholder="Tìm kiếm theo tên..." value="@Model.SearchQuery">
                        <button class="btn btn-outline-secondary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tất cả danh mục --</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryId" selected="@(Model.CategoryFilter == category.CategoryId)">
                                @category.CategoryName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="sortOrder" class="form-select" onchange="this.form.submit()">
                        <option value="newest" selected="@(Model.SortOrder == "newest")">Mới nhất</option>
                        <option value="oldest" selected="@(Model.SortOrder == "oldest")">Cũ nhất</option>
                        <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Tên A-Z</option>
                        <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Tên Z-A</option>
                        <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Giá tăng dần</option>
                        <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Giá giảm dần</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Lọc</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="alert alert-info">
            <p>Không tìm thấy sản phẩm nào phù hợp với tiêu chí tìm kiếm.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th style="width: 100px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Người bán</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>Ngày đăng</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>@product.ProductId</td>
                            <td>
                                @if (product.ImageUrls != null && product.ImageUrls.Any())
                                {
                                    <img src="@product.ImageUrls.First()" style="width: 60px; height: 60px; object-fit: cover;" alt="@product.Name">
                                }
                                else
                                {
                                    <img src="/images/no-image.png" style="width: 60px; height: 60px; object-fit: cover;" alt="Không có hình ảnh">
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@product.ProductId" class="text-decoration-none fw-bold">
                                    @product.Name
                                </a>
                                <div class="text-muted small text-truncate" style="max-width: 200px;">
                                    @(product.Description?.Substring(0, Math.Min(50, product.Description.Length)) ?? "")@(product.Description?.Length > 50 ? "..." : "")
                                </div>
                            </td>
                            <td>
                                @product.SellerName
                                <div class="small">ID: @product.UserId</div>
                            </td>
                            <td>@product.CategoryName</td>
                            <td>@product.Price.ToString("N0") VNĐ</td>
                            <td>
                                <div>@product.DatePosted.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted">@product.DatePosted.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <select class="form-select form-select-sm status-select" data-product-id="@product.ProductId">
                                    @* <option value="Active" @(product.Status == "Active" ? "selected" : "")>Đang bán</option>
                                    <option value="Inactive" @(product.Status == "Inactive" ? "selected" : "")>Tạm ngưng</option>
                                    <option value="Sold" @(product.Status == "Sold" ? "selected" : "")>Đã bán</option> *@
                                </select>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="ManageProducts" 
                           asp-route-searchQuery="@Model.SearchQuery" 
                           asp-route-categoryId="@Model.CategoryFilter" 
                           asp-route-sortOrder="@Model.SortOrder" 
                           asp-route-page="@(Model.CurrentPage - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                            startPage = Math.Max(1, endPage - 4);
                        }
                    }
                    
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="ManageProducts" 
                               asp-route-searchQuery="@Model.SearchQuery" 
                               asp-route-categoryId="@Model.CategoryFilter" 
                               asp-route-sortOrder="@Model.SortOrder" 
                               asp-route-page="@i">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="ManageProducts" 
                           asp-route-searchQuery="@Model.SearchQuery" 
                           asp-route-categoryId="@Model.CategoryFilter" 
                           asp-route-sortOrder="@Model.SortOrder" 
                           asp-route-page="@(Model.CurrentPage + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Xử lý thay đổi trạng thái sản phẩm
            $('.status-select').change(function() {
                var productId = $(this).data('product-id');
                var newStatus = $(this).val();
                
                $.ajax({
                    url: '@Url.Action("UpdateStatus")',
                    type: 'POST',
                    data: {
                        productId: productId,
                        status: newStatus,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(result) {
                        if (result.success) {
                            toastr.success('Cập nhật trạng thái thành công!');
                        } else {
                            toastr.error(result.message || 'Có lỗi xảy ra khi cập nhật trạng thái.');
                            // Reset về trạng thái cũ
                            location.reload();
                        }
                    },
                    error: function() {
                        toastr.error('Có lỗi xảy ra khi kết nối đến máy chủ.');
                        location.reload();
                    }
                });
            });
        });
    </script>
}
