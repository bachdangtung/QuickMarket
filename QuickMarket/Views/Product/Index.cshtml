@model BussinessLogic.DTOs.Products.ProductListDto

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <!-- Banner -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card bg-dark text-white mb-4">
                <img src="/images/banner-marketplace.jpg" class="card-img" alt="QuickMarket" style="height: 300px; object-fit: cover; opacity: 0.7;">
                <div class="card-img-overlay d-flex flex-column justify-content-center text-center">
                    <h1 class="card-title display-4 fw-bold">Chào mừng đến với QuickMarket</h1>
                    <p class="card-text fs-5">Nơi mua bán, trao đổi sản phẩm an toàn và tiện lợi</p>
                    @if (!(User.Identity?.IsAuthenticated ?? false))
                    {
                        <div>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2">Đăng ký</a>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">Đăng nhập</a>
                        </div>
                    }
                    else
                    {
                        <div>
                            <a asp-controller="Product" asp-action="Create" class="btn btn-success btn-lg">Đăng sản phẩm ngay</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <h1>@ViewData["Title"]</h1>

    <div class="row mb-4">
        <div class="col-md-12">
            <form method="get" class="card p-3 shadow-sm">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <input type="text" class="form-control" name="searchQuery" value="@Model.SearchQuery" placeholder="Tìm kiếm sản phẩm...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="categoryId">
                            <option value="">Tất cả danh mục</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId" selected="@(Model.CategoryFilter == category.CategoryId)">@category.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="sortOrder">
                            <option value="newest" selected="@(Model.SortOrder == "newest")">Mới nhất</option>
                            <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Giá tăng dần</option>
                            <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Giá giảm dần</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Lọc</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus"></i> Thêm sản phẩm mới
            </a>
        </div>
    </div>

    @if (Model.Products.Count == 0)
    {
        <div class="alert alert-info">
            Không tìm thấy sản phẩm nào phù hợp.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="position-relative product-image-container">
                            @if (product.ImageUrls != null && product.ImageUrls.Any())
                            {
                                <img src="@product.ImageUrls.First()" class="card-img-top" alt="@product.Name">
                            }
                            else
                            {
                                <img src="/images/no-image.png" class="card-img-top" alt="Không có hình ảnh">
                            }
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-truncate">
                                <a asp-action="Details" asp-route-id="@product.ProductId" class="text-decoration-none text-dark">
                                    @product.Name
                                </a>
                            </h5>
                            <p class="card-text text-danger fw-bold">@product.Price.ToString("N0") VNĐ</p>
                            <p class="card-text small text-muted">
                                <span class="badge bg-secondary">@product.CategoryName</span>
                            </p>
                            <p class="card-text small">
                                <i class="bi bi-calendar"></i> @product.DatePosted.ToString("dd/MM/yyyy")
                                <br />
                                <i class="bi bi-person"></i> @(product.SellerName ?? "Unknown")
                            </p>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-sm btn-primary">
                                    <i class="bi bi-info-circle"></i> Chi tiết
                                </a>
                                @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == product.UserId.ToString()))
                                {
                                    <div>
                                        <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-4">
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" 
                                   asp-route-searchQuery="@Model.SearchQuery" 
                                   asp-route-categoryId="@Model.CategoryFilter"
                                   asp-route-sortOrder="@Model.SortOrder">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>

@section Styles {
    <style>
        .product-image-container {
            height: 200px;
            overflow: hidden;
        }

        .product-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
}
