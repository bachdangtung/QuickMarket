@model QuickMarket.Models.ProductViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="product-gallery">
                @if (Model.ExistingImageUrls != null && Model.ExistingImageUrls.Any())
                {
                    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < Model.ExistingImageUrls.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@Model.ExistingImageUrls[i]" class="d-block w-100" alt="@Model.Name">
                                </div>
                            }
                        </div>
                        @if (Model.ExistingImageUrls.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        }
                    </div>

                    @if (Model.ExistingImageUrls.Count > 1)
                    {
                        <div class="d-flex mt-2 thumbnail-container">
                            @for (int i = 0; i < Model.ExistingImageUrls.Count; i++)
                            {
                                <div class="thumbnail me-2" onclick="showImage(@i)">
                                    <img src="@Model.ExistingImageUrls[i]" class="img-thumbnail" alt="@Model.Name">
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="no-image">
                        <img src="/images/no-image.png" class="img-fluid" alt="Không có hình ảnh">
                    </div>
                }
            </div>
        </div>

        <div class="col-md-6">
            <h1 class="mb-3">@Model.Name</h1>
            
            <div class="mb-3">
                <span class="badge bg-secondary">@Model.CategoryName</span>
                <span class="badge bg-@(Model.Status == "Active" ? "success" : "danger")">@Model.Status</span>
            </div>
            
            <p class="text-danger h3 mb-4">@Model.Price.ToString("N0") VNĐ</p>
            
            <div class="mb-4">
                <p><strong>Người bán:</strong> @Model.SellerName</p>
                <p><strong>Ngày đăng:</strong> @Model.DatePosted.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            
            <div class="mb-4">
                <h5>Mô tả</h5>
                <p class="text-muted">@Html.Raw(Model.Description?.Replace("\n", "<br />") ?? "Không có mô tả")</p>
            </div>

            <div class="d-flex gap-2">
                @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value == Model.UserId.ToString()))
                {
                    <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Xóa
                    </a>
                }

                <a asp-action="Index" class="btn btn-secondary ms-auto">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    <hr class="my-5" />

    <div class="row">
        <div class="col-md-8">
            <h3>Đánh giá sản phẩm</h3>
            
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                foreach (var review in Model.Reviews.OrderByDescending(r => r.ReviewDate))
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <h5 class="card-title">@review.UserName</h5>
                                <small class="text-muted">@review.ReviewDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <div class="mb-2">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                @for (int i = review.Rating; i < 5; i++)
                                {
                                    <i class="bi bi-star text-warning"></i>
                                }
                            </div>
                            <p class="card-text">@Html.Raw(review.Comment?.Replace("\n", "<br />") ?? "")</p>
                            
                            @if (User.Identity.IsAuthenticated)
                            {
                                <button class="btn btn-sm btn-outline-secondary reply-button" 
                                        data-review-id="@review.ReviewId" 
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#replyForm-@review.ReviewId">
                                    <i class="bi bi-reply"></i> Phản hồi
                                </button>
                                
                                <div class="collapse mt-2" id="replyForm-@review.ReviewId">
                                    <form asp-action="AddReview" method="post" class="reply-form">
                                        <input type="hidden" name="productId" value="@Model.ProductId" />
                                        <input type="hidden" name="threadId" value="@review.ReviewId" />
                                        <input type="hidden" name="rating" value="5" />
                                        <div class="mb-2">
                                            <textarea name="comment" class="form-control" rows="2" placeholder="Nhập phản hồi của bạn..."></textarea>
                                        </div>
                                        <div class="text-end">
                                            <button type="submit" class="btn btn-sm btn-primary">Gửi phản hồi</button>
                                        </div>
                                    </form>
                                </div>
                            }
                            
                            <!-- Hiển thị các phản hồi -->
                            @if (review.Replies != null && review.Replies.Any())
                            {
                                <div class="replies-container mt-3">
                                    @foreach (var reply in review.Replies.OrderBy(r => r.ReviewDate))
                                    {
                                        <div class="card reply-card mb-2">
                                            <div class="card-body py-2 px-3">
                                                <div class="d-flex justify-content-between">
                                                    <h6 class="card-title mb-1">@reply.UserName</h6>
                                                    <small class="text-muted">@reply.ReviewDate.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                                <p class="card-text mb-0 small">@Html.Raw(reply.Comment?.Replace("\n", "<br />") ?? "")</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">Chưa có đánh giá nào cho sản phẩm này.</p>
            }
            
            @if (User.Identity.IsAuthenticated && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value != Model.UserId.ToString())
            {
                bool hasReviewed = Model.Reviews?.Any(r => r.UserId.ToString() == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value) ?? false;
                
                if (!hasReviewed)
                {
                    <div class="card mt-4">
                        <div class="card-header">
                            <h5>Viết đánh giá</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="AddReview" method="post">
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <div class="mb-3">
                                    <label class="form-label">Đánh giá</label>
                                    <div class="rating">
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="rating" id="rating1" value="1" required>
                                            <label class="form-check-label" for="rating1">1 <i class="bi bi-star-fill"></i></label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="rating" id="rating2" value="2">
                                            <label class="form-check-label" for="rating2">2 <i class="bi bi-star-fill"></i></label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="rating" id="rating3" value="3">
                                            <label class="form-check-label" for="rating3">3 <i class="bi bi-star-fill"></i></label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="rating" id="rating4" value="4">
                                            <label class="form-check-label" for="rating4">4 <i class="bi bi-star-fill"></i></label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="rating" id="rating5" value="5">
                                            <label class="form-check-label" for="rating5">5 <i class="bi bi-star-fill"></i></label>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Nội dung đánh giá</label>
                                    <textarea name="comment" class="form-control" rows="3"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showImage(index) {
            var carousel = document.getElementById('productCarousel');
            var carouselInstance = bootstrap.Carousel.getInstance(carousel);
            carouselInstance.to(index);
        }
    </script>
}

@section Styles {
    <style>
        .product-gallery {
            margin-bottom: 30px;
        }

        .carousel-item img {
            width: 100%;
            height: 400px;
            object-fit: contain;
            background-color: #f8f9fa;
        }

        .thumbnail-container {
            overflow-x: auto;
        }

        .thumbnail {
            width: 80px;
            cursor: pointer;
        }

        .thumbnail img {
            height: 80px;
            object-fit: cover;
        }

        .no-image {
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
        }
        
        /* Styles cho phần đánh giá và phản hồi */
        .replies-container {
            padding-left: 20px;
            border-left: 3px solid #eee;
            margin-top: 15px;
        }
        
        .reply-card {
            background-color: #f8f9fa;
            border-left: 3px solid #0d6efd;
        }
        
        .reply-button {
            font-size: 0.8rem;
            padding: 0.25rem 0.5rem;
        }
        
        .reply-form {
            background-color: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
        }
    </style>
}
