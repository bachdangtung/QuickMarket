@model BussinessLogic.DTOs.Products.ProductCreateUpdateDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="product-gallery">
                @if (Model.ExistingImageUrls != null && Model.ExistingImageUrls.Any())
                {
                    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < Model.ExistingImageUrls.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@Model.ExistingImageUrls[i]" class="d-block w-100" alt="@Model.Name">
                                </div>
                            }
                        </div>
                        @if (Model.ExistingImageUrls.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        }
                    </div>

                    @if (Model.ExistingImageUrls.Count > 1)
                    {
                        <div class="d-flex mt-2 thumbnail-container">
                            @for (int i = 0; i < Model.ExistingImageUrls.Count; i++)
                            {
                                <div class="thumbnail me-2" onclick="showImage(@i)">
                                    <img src="@Model.ExistingImageUrls[i]" class="img-thumbnail" alt="@Model.Name">
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="no-image">
                        <img src="/images/no-image.png" class="img-fluid" alt="Không có hình ảnh">
                    </div>
                }
            </div>
        </div>

        <div class="col-md-6">
            <h1 class="mb-3">@Model.Name</h1>
            
            <div class="mb-3">
                <span class="badge bg-secondary">@Model.CategoryName</span>
                <span class="badge bg-@(Model.Status == "Active" ? "success" : "danger")">@Model.Status</span>
            </div>
            
            <p class="text-danger h3 mb-4">@Model.Price.ToString("N0") VNĐ</p>
            
            <div class="mb-4">
                <p><strong>Người bán:</strong> @Model.SellerName</p>
                <p><strong>Ngày đăng:</strong> @Model.DatePosted.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            
            <div class="mb-4">
                <h5>Mô tả</h5>
                <p class="text-muted">@Html.Raw(Model.Description?.Replace("\n", "<br />") ?? "Không có mô tả")</p>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
                @if (User.Identity != null && User.Identity.IsAuthenticated && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.UserId.ToString())
                {
                    <a href="@Url.Action("Index", "Message", new { userId = Model.UserId, productId = Model.ProductId })" class="btn btn-primary">
                        <i class="bi bi-chat-dots"></i> Chat với người bán
                    </a>
                    
                    <button id="favoriteBtn" class="btn btn-outline-danger" data-product-id="@Model.ProductId">
                        <i class="far fa-heart"></i> Yêu thích
                    </button>
                }
            </div>
        </div>
    </div>

    <hr class="my-5" />

    <div class="row">
        <div class="col-md-8">
            <h3>Đánh giá sản phẩm</h3>
            
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            
            @{
                int totalReviews = Model.Reviews?.Count ?? 0;
                int commentCount = Model.Reviews?.Count(r => r.Rating == 0) ?? 0;
                int ratingCount = Model.Reviews?.Count(r => r.Rating > 0) ?? 0;
            }
            <div class="text-muted mb-2">
                Có @totalReviews đánh giá/bình luận (@ratingCount đánh giá, @commentCount bình luận)
            </div>
            
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                foreach (var review in Model.Reviews.OrderByDescending(r => r.ReviewDate))
                {
                    <div class="card mb-3">
                        <div class="card-header bg-light d-flex justify-content-between">
                            <div>
                                <strong>@review.UserName</strong>
                                @if(review.Rating > 0)
                                {
                                    <div class="text-warning">
                                        @for (int i = 0; i < review.Rating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        @for (int i = review.Rating; i < 5; i++)
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Bình luận</span>
                                }
                            </div>
                            <small class="text-muted">@review.ReviewDate.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="card-body">
                            <p class="card-text">@review.Comment</p>
                            
                            @if (review.Replies != null && review.Replies.Any())
                            {
                                <div class="replies-container mt-3">
                                    <h6 class="text-muted mb-3">Phản hồi:</h6>
                                    @foreach (var reply in review.Replies)
                                    {
                                        <div class="card reply-card mb-2">
                                            <div class="card-body py-2">
                                                <div class="d-flex justify-content-between">
                                                    <strong>@reply.UserName</strong>
                                                    <small class="text-muted">@reply.ReviewDate.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                                <p class="card-text mb-0">@reply.Comment</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            
                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <button class="btn btn-sm btn-outline-secondary reply-button mt-2" 
                                        onclick="toggleReplyForm('@review.ReviewId')">
                                    <i class="bi bi-reply"></i> Phản hồi
                                </button>
                                
                                <div id="replyForm-@review.ReviewId" class="reply-form mt-3" style="display: none;">
                                    <form asp-action="AddReview" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@Model.ProductId" />
                                        <input type="hidden" name="rating" value="0" />
                                        <input type="hidden" name="threadId" value="@review.ReviewId" />
                                        
                                        <div class="mb-3">
                                            <textarea name="comment" class="form-control" rows="2" placeholder="Nhập phản hồi của bạn..." required></textarea>
                                        </div>
                                        
                                        <button type="submit" class="btn btn-sm btn-primary">Gửi phản hồi</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleReplyForm('@review.ReviewId')">Hủy</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    Sản phẩm này chưa có đánh giá nào.
                </div>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != Model.UserId.ToString())
            {
                @if (ViewBag.HasPurchased == true)
                {
                    <div class="card mt-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Đánh giá của bạn</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="AddReview" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                
                                <div class="mb-3">
                                    <label class="form-label">Đánh giá</label>
                                    <div class="rating">
                                        <div class="star-rating">
                                            <input type="radio" id="star5" name="rating" value="5" checked />
                                            <label for="star5" title="5 sao"><i class="bi bi-star-fill"></i></label>
                                            <input type="radio" id="star4" name="rating" value="4" />
                                            <label for="star4" title="4 sao"><i class="bi bi-star-fill"></i></label>
                                            <input type="radio" id="star3" name="rating" value="3" />
                                            <label for="star3" title="3 sao"><i class="bi bi-star-fill"></i></label>
                                            <input type="radio" id="star2" name="rating" value="2" />
                                            <label for="star2" title="2 sao"><i class="bi bi-star-fill"></i></label>
                                            <input type="radio" id="star1" name="rating" value="1" />
                                            <label for="star1" title="1 sao"><i class="bi bi-star-fill"></i></label>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label">Nhận xét của bạn</label>
                                    <textarea name="comment" class="form-control" rows="3" placeholder="Nhập nhận xét của bạn..." required></textarea>
                                </div>
                                
                                <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card mt-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Bình luận của bạn</h5>
                            <small class="text-muted">(Bạn cần mua sản phẩm để có thể đánh giá sao)</small>
                        </div>
                        <div class="card-body">
                            <form asp-action="AddReview" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.ProductId" />
                                <input type="hidden" name="rating" value="0" />
                                
                                <div class="mb-3">
                                    <label class="form-label">Bình luận của bạn</label>
                                    <textarea name="comment" class="form-control" rows="3" placeholder="Nhập bình luận của bạn..." required></textarea>
                                </div>
                                
                                <button type="submit" class="btn btn-primary">Gửi bình luận</button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Thông tin thêm</h5>
                </div>
                <div class="card-body">
                    <p><strong>Danh mục:</strong> @Model.CategoryName</p>
                    <p><strong>Trạng thái:</strong> @Model.Status</p>
                    <p><strong>Đăng bởi:</strong> @Model.SellerName</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="~/js/product-favorites.js"></script>
    
    <script>
        // Xử lý hiển thị hình ảnh thu nhỏ khi được click
        function showImage(index) {
            $('#productCarousel').carousel(index);
        }
        
        // Xử lý hiển thị/ẩn form phản hồi
        function toggleReplyForm(reviewId) {
            $('#replyForm-' + reviewId).toggle();
        }
        
        // Xử lý hiển thị số sao đã chọn
        $(document).ready(function() {
            $('.star-rating input').on('change', function() {
                var ratingValue = $(this).val();
                console.log('Đã chọn: ' + ratingValue + ' sao');
            });
        });
        
        // Xử lý thêm/xóa sản phẩm yêu thích
        $(document).ready(function() {
            $('#toggleFavoriteBtn').click(function() {
                $.ajax({
                    url: '@Url.Action("ToggleFavorite", "Product")',
                    type: 'POST',
                    data: {
                        productId: @Model.ProductId
                    },
                    success: function(response) {
                        if (response.success) {
                            // Cập nhật UI
                            if (response.isFavorite) {
                                $('#toggleFavoriteBtn').removeClass('btn-outline-danger').addClass('btn-danger');
                                $('#toggleFavoriteBtn i').removeClass('bi-heart').addClass('bi-heart-fill');
                                $('#favoriteText').text('Đã yêu thích');
                            } else {
                                $('#toggleFavoriteBtn').removeClass('btn-danger').addClass('btn-outline-danger');
                                $('#toggleFavoriteBtn i').removeClass('bi-heart-fill').addClass('bi-heart');
                                $('#favoriteText').text('Yêu thích');
                            }
                        } else {
                            alert(response.message || 'Có lỗi xảy ra khi thực hiện thao tác.');
                        }
                    },
                    error: function() {
                        alert('Có lỗi xảy ra khi kết nối với máy chủ.');
                    }
                });
            });
        });
    </script>
    
    <style>
        /* Styles cho gallery */
        .product-gallery {
            margin-bottom: 30px;
        }
        
        .thumbnail-container {
            overflow-x: auto;
            white-space: nowrap;
        }
        
        .thumbnail {
            width: 80px;
            display: inline-block;
            cursor: pointer;
        }
        
        .thumbnail img {
            width: 100%;
            height: 60px;
            object-fit: cover;
        }
        
        .no-image {
            height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
            border: 1px solid #ddd;
        }
        
        /* Styles cho phần đánh giá và phản hồi */
        .replies-container {
            padding-left: 20px;
            border-left: 3px solid #eee;
            margin-top: 15px;
        }
        
        .reply-card {
            background-color: #f8f9fa;
            border-left: 3px solid #0d6efd;
        }
        
        .reply-button {
            font-size: 0.8rem;
            padding: 0.25rem 0.5rem;
        }
        
        .reply-form {
            background-color: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
        }
        
        /* Styles cho rating */
        .star-rating {
            display: inline-flex;
            flex-direction: row-reverse;
            border: 0;
        }
        .star-rating > input {
            display: none;
        }
        .star-rating > label {
            float: right;
            color: #ddd;
            font-size: 1.5rem;
            padding: 0 0.2rem;
            cursor: pointer;
        }
        .star-rating > input:checked ~ label,
        .star-rating > label:hover,
        .star-rating > label:hover ~ label { 
            color: #ffc107; 
        } 
        .star-rating > input:checked + label:hover,
        .star-rating > input:checked ~ label:hover,
        .star-rating > input:checked ~ label:hover ~ label,
        .star-rating > label:hover ~ input:checked ~ label { 
            color: #ffdb70; 
        }
        
        /* Favorite button styles */
        .favorite-active {
            background-color: #dc3545 !important;
            color: white !important;
        }
    </style>
}
