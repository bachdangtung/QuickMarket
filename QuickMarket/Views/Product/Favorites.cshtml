@model BussinessLogic.DTOs.Products.ProductListDto

@{
    ViewData["Title"] = "Quản lý sản phẩm yêu thích";
}

<div class="container-fluid mt-4">
    <div class="row">
        <!-- Sidebar với các tùy chọn lọc và phân loại -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-heart-fill me-2"></i>Quản lý yêu thích</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="sortOrder" class="form-label">Sắp xếp theo:</label>
                        <select id="sortOrder" class="form-select form-select-sm">
                            <option value="newest">Mới nhất</option>
                            <option value="oldest">Cũ nhất</option>
                            <option value="priceAsc">Giá tăng dần</option>
                            <option value="priceDesc">Giá giảm dần</option>
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label for="categoryFilter" class="form-label">Danh mục:</label>
                        <select id="categoryFilter" class="form-select form-select-sm">
                            <option value="">Tất cả danh mục</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                    </div>
                    
                    <div class="d-grid gap-2 mt-4">
                        <button id="applyFilters" class="btn btn-sm btn-primary">
                            <i class="bi bi-funnel me-1"></i> Lọc
                        </button>
                        <button id="removeAllFavorites" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash me-1"></i> Xóa tất cả
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body p-3">
                    <h6 class="card-title"><i class="bi bi-info-circle me-2"></i>Thông tin</h6>
                    <p class="card-text small mb-0">Tổng số: <strong>@Model.Products.Count</strong> sản phẩm</p>
                </div>
            </div>
        </div>
        
        <!-- Nội dung chính - Danh sách sản phẩm yêu thích -->
        <div class="col-lg-9 col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="bi bi-bookmark-heart text-danger me-2"></i>Sản phẩm yêu thích của bạn</h4>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="toggleViewMode">
                            <label class="form-check-label" for="toggleViewMode">Chế độ bảng/lưới</label>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Products.Count == 0)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i> Bạn chưa có sản phẩm yêu thích nào.
                            <a asp-controller="Product" asp-action="Index" class="alert-link">Khám phá sản phẩm ngay!</a>
                        </div>
                    }
                    else
                    {
                        <!-- Chế độ xem bảng -->
                        <div id="tableView">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th style="width: 50px;">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="selectAll">
                                                </div>
                                            </th>
                                            <th style="width: 80px;">Ảnh</th>
                                            <th>Tên sản phẩm</th>
                                            <th>Danh mục</th>
                                            <th class="text-end">Giá</th>
                                            <th>Người bán</th>
                                            <th>Ngày đăng</th>
                                            <th style="width: 100px;">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var product in Model.Products)
                                        {
                                            <tr class="product-row" data-product-id="@product.ProductId">
                                                <td>
                                                    <div class="form-check">
                                                        <input class="form-check-input product-checkbox" type="checkbox" value="@product.ProductId">
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (product.ImageUrls != null && product.ImageUrls.Any())
                                                    {
                                                        <img src="@product.ImageUrls.First()" alt="@product.Name" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <img src="/images/no-image.png" alt="Không có hình ảnh" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;">
                                                    }
                                                </td>
                                                <td>
                                                    <a asp-action="Details" asp-route-id="@product.ProductId" class="text-decoration-none text-dark fw-medium">
                                                        @product.Name
                                                    </a>
                                                </td>
                                                <td><span class="badge bg-secondary">@product.CategoryName</span></td>
                                                <td class="text-end fw-bold text-danger">@product.Price.ToString("N0") VNĐ</td>
                                                <td>@(product.SellerName ?? "Unknown")</td>
                                                <td>@product.DatePosted.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-outline-primary" title="Chi tiết">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <button class="btn btn-outline-danger remove-favorite" data-product-id="@product.ProductId" title="Xóa">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            
                            <div class="d-flex justify-content-end mt-3">
                                <button id="removeSelected" class="btn btn-sm btn-danger me-2" disabled>
                                    <i class="bi bi-trash me-1"></i> Xóa đã chọn (<span id="selectedCount">0</span>)
                                </button>
                            </div>
                        </div>

                        <!-- Chế độ xem lưới (ban đầu ẩn đi) -->
                        <div id="gridView" style="display: none;">
                            <div class="row row-cols-1 row-cols-md-3 row-cols-lg-3 g-4">
                                @foreach (var product in Model.Products)
                                {
                                    <div class="col">
                                        <div class="card h-100 shadow-sm product-card">
                                            <div class="position-absolute" style="right: 10px; top: 10px;">
                                                <div class="btn-group">
                                                    <button class="btn btn-sm btn-danger remove-favorite" data-product-id="@product.ProductId">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                    <div class="form-check ms-2 mt-1">
                                                        <input class="form-check-input product-checkbox-grid" type="checkbox" value="@product.ProductId">
                                                    </div>
                                                </div>
                                            </div>
                                            <a asp-action="Details" asp-route-id="@product.ProductId" class="text-decoration-none">
                                                <div class="position-relative product-image-container">
                                                    @if (product.ImageUrls != null && product.ImageUrls.Any())
                                                    {
                                                        <img src="@product.ImageUrls.First()" class="card-img-top" alt="@product.Name">
                                                    }
                                                    else
                                                    {
                                                        <img src="/images/no-image.png" class="card-img-top" alt="Không có hình ảnh">
                                                    }
                                                </div>
                                                <div class="card-body">
                                                    <h5 class="card-title text-truncate text-dark">
                                                        @product.Name
                                                    </h5>
                                                    <p class="card-text text-danger fw-bold">@product.Price.ToString("N0") VNĐ</p>
                                                    <p class="card-text small text-muted">
                                                        <span class="badge bg-secondary">@product.CategoryName</span>
                                                    </p>
                                                    <p class="card-text small">
                                                        <i class="bi bi-calendar"></i> @product.DatePosted.ToString("dd/MM/yyyy")
                                                        <br />
                                                        <i class="bi bi-person"></i> @(product.SellerName ?? "Unknown")
                                                    </p>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <!-- Phân trang -->
                        @if (Model.TotalPages > 1)
                        {
                            <nav aria-label="Page navigation" class="mt-4">
                                <ul class="pagination justify-content-center">
                                    @if (Model.CurrentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Favorites" asp-route-page="@(Model.CurrentPage - 1)" aria-label="Previous">
                                                <span aria-hidden="true">&laquo;</span>
                                            </a>
                                        </li>
                                    }
                                    
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                            <a class="page-link" asp-action="Favorites" asp-route-page="@i">@i</a>
                                        </li>
                                    }
                                    
                                    @if (Model.CurrentPage < Model.TotalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Favorites" asp-route-page="@(Model.CurrentPage + 1)" aria-label="Next">
                                                <span aria-hidden="true">&raquo;</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Xử lý chuyển đổi giữa chế độ bảng và lưới
            $("#toggleViewMode").change(function() {
                if ($(this).is(":checked")) {
                    $("#tableView").hide();
                    $("#gridView").fadeIn();
                } else {
                    $("#gridView").hide();
                    $("#tableView").fadeIn();
                }
            });
            
            // Xử lý checkbox "Chọn tất cả"
            $("#selectAll").change(function() {
                const isChecked = $(this).is(":checked");
                $(".product-checkbox, .product-checkbox-grid").prop("checked", isChecked);
                updateSelectedCount();
            });
            
            // Xử lý khi checkbox sản phẩm thay đổi
            $(document).on("change", ".product-checkbox, .product-checkbox-grid", function() {
                updateSelectedCount();
            });
            
            // Cập nhật số lượng đã chọn và trạng thái nút xóa
            function updateSelectedCount() {
                const count = $(".product-checkbox:checked, .product-checkbox-grid:checked").length;
                $("#selectedCount").text(count);
                
                if (count > 0) {
                    $("#removeSelected").prop("disabled", false);
                } else {
                    $("#removeSelected").prop("disabled", true);
                }
            }
            
            // Xử lý nút xóa khỏi yêu thích
            $(document).on('click', '.remove-favorite', function(e) {
                e.preventDefault();
                const productId = $(this).data('product-id');
                const element = $(this).closest('.product-row, .col');
                
                removeFavorite(productId, element);
            });
            
            // Xử lý xóa nhiều sản phẩm yêu thích
            $("#removeSelected").click(function() {
                const selectedIds = [];
                $(".product-checkbox:checked, .product-checkbox-grid:checked").each(function() {
                    selectedIds.push($(this).val());
                });
                
                if (selectedIds.length > 0) {
                    if (confirm(`Bạn có chắc muốn xóa ${selectedIds.length} sản phẩm khỏi danh sách yêu thích?`)) {
                        // Xóa từng sản phẩm đã chọn
                        let processedCount = 0;
                        
                        selectedIds.forEach(function(productId) {
                            const tableRow = $(`.product-row[data-product-id="${productId}"]`);
                            const gridItem = $(`.product-card`).closest('.col').has(`.product-checkbox-grid[value="${productId}"]`);
                            
                            $.ajax({
                                url: '@Url.Action("RemoveFavorite", "Product")',
                                type: 'POST',
                                data: { productId: productId },
                                success: function(response) {
                                    if (response.success) {
                                        tableRow.fadeOut(300, function() { $(this).remove(); });
                                        gridItem.fadeOut(300, function() { $(this).remove(); });
                                        
                                        processedCount++;
                                        
                                        // Kiểm tra nếu tất cả đã được xử lý
                                        if (processedCount === selectedIds.length) {
                                            updateSelectedCount();
                                            
                                            // Kiểm tra nếu không còn sản phẩm nào thì hiển thị thông báo
                                            if ($('.product-row, .col').length === 0) {
                                                location.reload();
                                            }
                                            
                                            toastr.success(`Đã xóa ${selectedIds.length} sản phẩm khỏi danh sách yêu thích`);
                                        }
                                    }
                                },
                                error: function() {
                                    toastr.error('Có lỗi xảy ra khi xóa sản phẩm. Vui lòng thử lại sau.');
                                }
                            });
                        });
                    }
                }
            });
            
            // Xử lý nút xóa tất cả sản phẩm yêu thích
            $("#removeAllFavorites").click(function() {
                if (confirm("Bạn có chắc muốn xóa tất cả sản phẩm khỏi danh sách yêu thích?")) {
                    // Lấy tất cả ID sản phẩm
                    const allProductIds = [];
                    $(".product-row").each(function() {
                        allProductIds.push($(this).data('product-id'));
                    });
                    
                    if (allProductIds.length > 0) {
                        // Gọi API xóa tất cả trong một lần (giả định API hỗ trợ)
                        // Hoặc xử lý từng sản phẩm một
                        let processedCount = 0;
                        
                        allProductIds.forEach(function(productId) {
                            $.ajax({
                                url: '@Url.Action("RemoveFavorite", "Product")',
                                type: 'POST',
                                data: { productId: productId },
                                success: function(response) {
                                    if (response.success) {
                                        processedCount++;
                                        
                                        // Kiểm tra nếu tất cả đã được xử lý
                                        if (processedCount === allProductIds.length) {
                                            location.reload(); // Làm mới trang sau khi xóa tất cả
                                        }
                                    }
                                },
                                error: function() {
                                    toastr.error('Có lỗi xảy ra khi xóa sản phẩm. Vui lòng thử lại sau.');
                                }
                            });
                        });
                    }
                }
            });
            
            // Xử lý áp dụng bộ lọc
            $("#applyFilters").click(function() {
                const sortOrder = $("#sortOrder").val();
                const categoryFilter = $("#categoryFilter").val();
                
                // Xây dựng URL với tham số lọc
                let url = '@Url.Action("Favorites", "Product")';
                const params = [];
                
                if (sortOrder) {
                    params.push(`sort=${sortOrder}`);
                }
                
                if (categoryFilter) {
                    params.push(`category=${categoryFilter}`);
                }
                
                if (params.length > 0) {
                    url += '?' + params.join('&');
                }
                
                // Chuyển hướng đến URL với bộ lọc
                window.location.href = url;
            });
            
            // Hàm xóa sản phẩm yêu thích
            function removeFavorite(productId, element) {
                $.ajax({
                    url: '@Url.Action("RemoveFavorite", "Product")',
                    type: 'POST',
                    data: { productId: productId },
                    success: function(response) {
                        if (response.success) {
                            // Hiệu ứng xóa khỏi giao diện
                            element.fadeOut(300, function() {
                                $(this).remove();
                                
                                // Kiểm tra nếu không còn sản phẩm nào thì hiển thị thông báo
                                if ($('.product-row, .col').length === 0) {
                                    location.reload();
                                }
                                
                                updateSelectedCount();
                            });
                            
                            toastr.success('Đã xóa khỏi danh sách yêu thích');
                        } else {
                            toastr.error(response.message || 'Không thể xóa khỏi danh sách yêu thích');
                        }
                    },
                    error: function() {
                        toastr.error('Có lỗi xảy ra. Vui lòng thử lại sau.');
                    }
                });
            }
        });
    </script>
}
