@model BussinessLogic.DTOs.Products.ProductListDto

@{
    ViewData["Title"] = "Sản phẩm của tôi";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="row mb-3">
        <div class="col">
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus"></i> Thêm sản phẩm mới
            </a>
        </div>
    </div>

    @if (Model.Products.Count == 0)
    {
        <div class="alert alert-info">
            <p>Bạn chưa có sản phẩm nào.</p>
            <a asp-action="Create" class="btn btn-primary">Đăng sản phẩm ngay</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th>Ngày đăng</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td style="width: 100px;">
                                @if (product.ImageUrls != null && product.ImageUrls.Any())
                                {
                                    <img src="@product.ImageUrls.First()" style="width: 80px; height: 80px; object-fit: cover;" alt="@product.Name">
                                }
                                else
                                {
                                    <img src="/images/no-image.png" style="width: 80px; height: 80px; object-fit: cover;" alt="Không có hình ảnh">
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@product.ProductId" class="text-decoration-none">
                                    @product.Name
                                </a>
                            </td>
                            <td>@product.CategoryName</td>
                            <td>@product.Price.ToString("N0") VNĐ</td>
                            <td>@product.DatePosted.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-@(product.Status == "Active" ? "success" : product.Status == "Sold" ? "primary" : "warning")">
                                    @(product.Status == "Active" ? "Đang bán" : product.Status == "Sold" ? "Đã bán" : "Tạm ngưng")
                                </span>
                            </td>
                            <td>
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách sản phẩm
        </a>
    </div>
</div>
